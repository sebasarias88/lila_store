# Supabase (Vercel → Settings → Environment Variables)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Real public URL of the site (canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.lilastore.com.co

# Cloudflare R2 (images and videos). Keys: server only, never NEXT_PUBLIC_.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=lilastore-images
R2_PUBLIC_BASE_URL=https://img.lilastore.com.co
NEXT_PUBLIC_IMAGE_BASE_URL=https://img.lilastore.com.co

# Mipaquete (shipping quotes). Server only.
MIPAQUETE_API_KEY=
# Optional: MIPAQUETE_API_URL=https://api-v2.mipaquete.com
# Optional: MIPAQUETE_ORIGIN_DANE=63594000   (Quimbaya)

# Optional: MAINTENANCE_MODE=true shows the maintenance screen (redeploy needed)
